---
import { getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Qinyuhang`} description={post.data.description}>
  <article class="article">
    <header class="article-header">
      <div class="meta">{post.data.publishedAt.toLocaleDateString('zh-CN')}</div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tags">{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div>
    </header>
    <div class="article-body"><Content /></div>
    <Comments />
  </article>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout>
  <section class="hero">
    <p class="meta">SOFTWARE · SYSTEMS · NOTES</p>
    <h1>Make things clear.</h1>
    <p>记录软件工程、系统实践，以及值得长期保留的技术判断。</p>
  </section>

  <section class="post-list" aria-label="文章列表">
    {posts.map((post) => (
      <article class="post-card">
        <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
        <div class="meta">{post.data.publishedAt.toLocaleDateString('zh-CN')}</div>
        <p>{post.data.description}</p>
        <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </article>
    ))}
  </section>
</BaseLayout>

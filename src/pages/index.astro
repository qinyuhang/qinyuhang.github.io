---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout>
  <section class="hero">
    <p class="meta">NOTES * LIFE</p>
    <h1>I think, therefore I am</h1>
    <p>一些碎碎念随笔</p>
  </section>

  <section class="post-list" aria-label="文章列表">
    {posts.map((post) => (
      <article class="post-card">
        <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
        <div class="meta">{post.data.publishedAt.toLocaleDateString('zh-CN')}</div>
        <p>{post.data.description}</p>
        <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </article>
    ))}
  </section>
</BaseLayout>
